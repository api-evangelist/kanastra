            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Read LineCode"
        },
        {
          "info": {
            "name": "Pay from previous read",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://banking.kanastra.com.br/api/v1/:account_id/payments",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": " Variants: Pay BankSlip from LineCode, Pay BankSlip from BarCode"
        }
      ]
    }
  ],
  "bundled": true
}