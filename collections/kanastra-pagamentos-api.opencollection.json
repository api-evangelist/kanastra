{
  "opencollection": "1.0.0",
  "info": {
    "name": "Kanastra Banking Accounts Pagamentos API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Pagamentos",
        "type": "folder"
      },
      "items": [
